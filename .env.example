# Analytics — all optional. Set these in Netlify → Site configuration → Environment variables.
# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=
# Plausible: the domain you registered in Plausible (e.g. hisaabhouse.netlify.app)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Meta (Facebook/Instagram) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
